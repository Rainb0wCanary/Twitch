{
  "manifest_version": 3,
  "name": "Drops — Auto Collector",
  "version": "1.5.1",
  "description": "Автоматический сбор Drops с Twitch и Kick для любых игр и категорий. Умные кампании, авто-конфиг, приоритеты и таймеры.",
  "permissions": ["scripting", "storage", "activeTab", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*", "*://*.kick.com/*"],
      "js": ["content.js"]
    }
  ]
}
  